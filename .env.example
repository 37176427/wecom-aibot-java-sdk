# Copy to .env.local (ignored by Git); do not commit real credentials.
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Public deployment default; use the exact administrator-provided endpoint for private deployment.
# WECOM_WS_URL=wss://openws.work.weixin.qq.com
# Optional pre-authorized single-chat tester, useful for the first enter_chat welcome event.
# WECOM_TEST_USER_ID=
# Optional local test assets; ensure they contain no production data.
# WECOM_TEST_VOICE_FILE=/absolute/path/test.amr
# WECOM_TEST_VIDEO_FILE=/absolute/path/test.mp4

# Reachable HTTPS image URL used only by the news card test.
# WECOM_TEST_CARD_IMAGE_URL=https://your-test-host/image.png
